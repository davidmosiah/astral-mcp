{
  "version": 2,
  "builds": [
    { "src": "docs/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/docs/index.html" },
    { "src": "/guides/what-is-an-astrology-mcp-server", "dest": "/docs/guides/what-is-an-astrology-mcp-server.html" },
    { "src": "/guides/how-to-generate-a-natal-chart-with-mcp", "dest": "/docs/guides/how-to-generate-a-natal-chart-with-mcp.html" },
    { "src": "/(.*)", "dest": "/docs/$1" }
  ]
}
